{
  "name": "Learning Line: yellow andon and new Kaizen ticket to Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "learning-line",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "5b1f0a9e-2f7c-4a51-9f0e-1c0a8e1d0001",
      "name": "Learning Line events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "learning-line"
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.events",
        "options": {}
      },
      "id": "5b1f0a9e-2f7c-4a51-9f0e-1c0a8e1d0002",
      "name": "One item per event",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "andon.yellow",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5b1f0a9e-2f7c-4a51-9f0e-1c0a8e1d0003",
      "name": "Yellow andon?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.type }}",
              "rightValue": "ticket.opened",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5b1f0a9e-2f7c-4a51-9f0e-1c0a8e1d0004",
      "name": "New Kaizen ticket?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [480, 420]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_TEAM_LEADER_GROUP_CHAT_ID",
        "text": "=Yellow andon at {{ $json.stationId }}\n{{ $json.data.defect_type }} on {{ $json.data.roi }}, body {{ $json.data.body_id }}\nConfirmed by {{ $json.data.decided_by }} at {{ $json.timestamp }}\nTeam leader decides: stop and fix, contain, or continue.",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "5b1f0a9e-2f7c-4a51-9f0e-1c0a8e1d0005",
      "name": "Telegram: team leaders",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 200],
      "credentials": { "telegramApi": { "id": "REPLACE", "name": "Learning Line bot" } }
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_ENGINEER_GROUP_CHAT_ID",
        "text": "=New Kaizen ticket {{ $json.data.ticket_id }} at {{ $json.stationId }}\n{{ $json.data.defect_type }}, {{ $json.data.trigger_alerts }} confirmed alerts this shift\nOwner: {{ $json.data.owner_role }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "5b1f0a9e-2f7c-4a51-9f0e-1c0a8e1d0006",
      "name": "Telegram: engineers",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 420],
      "credentials": { "telegramApi": { "id": "REPLACE", "name": "Learning Line bot" } }
    }
  ],
  "connections": {
    "Learning Line events": { "main": [[{ "node": "One item per event", "type": "main", "index": 0 }]] },
    "One item per event": {
      "main": [[
        { "node": "Yellow andon?", "type": "main", "index": 0 },
